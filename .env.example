# Copy to .env and fill in. Never commit .env.

LLM_PROVIDER=anthropic
# Create at console.anthropic.com (separate from a Claude.ai subscription). Needed from step S5 only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

MAX_TOOL_ROUNDS=20
WORKSPACE_DIR=./workspace
MAX_UNZIPPED_MB=2000

# true = write each request to the audit log but never send it
DRY_RUN=false
