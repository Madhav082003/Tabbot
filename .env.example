# Copy to .env and fill in. Never commit .env.

LLM_PROVIDER=anthropic
# Create at console.anthropic.com (separate from a Claude.ai subscription). Needed for the chat only.
ANTHROPIC_API_KEY=

# claude-opus-5-5 (default) | claude-sonnet-5-5 (cheaper, faster)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = more thorough, slower, more tokens)
CLAUDE_EFFORT=medium
# true = if a safety classifier declines a request, the API retries it on a fallback model
CLAUDE_FALLBACK=true

# ---- spend safety (checked BEFORE every request; a request that could pass a limit is not sent)
# estimated USD for all API calls of one question
LLM_MAX_USD_PER_QUESTION=0.50
# estimated USD for all API calls today on this machine
LLM_MAX_USD_PER_DAY=5.00
LLM_MAX_CALLS_PER_DAY=200
# API calls per question (each tool round is one call)
MAX_TOOL_ROUNDS=8
# output tokens per API call
LLM_MAX_OUTPUT_TOKENS=8000
WORKSPACE_DIR=./workspace
MAX_UNZIPPED_MB=2000

# true = write each request to the audit log but never send it
DRY_RUN=false
