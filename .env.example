# Copy to .env and fill in. Never commit .env.

LLM_PROVIDER=anthropic
# Create at console.anthropic.com (separate from a Claude.ai subscription). Needed for the chat only.
ANTHROPIC_API_KEY=

# claude-opus-5-5 (default) | claude-sonnet-5-5 (cheaper, faster)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = more thorough, slower, more tokens)
CLAUDE_EFFORT=medium
# true = if a safety classifier declines a request, the API retries it on a fallback model
CLAUDE_FALLBACK=true

MAX_TOOL_ROUNDS=20
WORKSPACE_DIR=./workspace
MAX_UNZIPPED_MB=2000

# true = write each request to the audit log but never send it
DRY_RUN=false
